# Copy to .env next to docker-compose.yml (never commit it). Docker Compose
# reads it to fill in the ${...} references in docker-compose.yml; settings such
# as EV_PROVIDER and EV_REPOS go in the compose file's `environment:` block.

# Tokens (read-only access to issues is enough). Set the one your tracker uses.
GITHUB_TOKEN=
GITEA_TOKEN=

# Optional: the login for the whole app, as "user:password". Uncomment the
# EV_BASIC_AUTH line in docker-compose.yml too.
# EV_BASIC_AUTH=
