# Copy to .env (never commit it). Loaded by docker compose via env_file.

# --- Env-only mode: one view over one or more repositories, no config file ---
# Leave these unset when you use config.yaml instead.
EV_PROVIDER=github
EV_REPOS=owner/repo
# Gitea/Forgejo only: the instance root URL, without /api/v1.
# EV_BASE_URL=https://gitea.example.com
# Optional: priority labels, highest first.
# EV_PRIORITY_LABELS=P0,P1,P2

# --- Tokens (read-only access to issues is enough) ---
# GitHub sources.
GITHUB_TOKEN=
# Gitea/Forgejo sources.
GITEA_TOKEN=

# Optional: protect the whole app with HTTP basic auth, as "user:password".
# EV_BASIC_AUTH=
